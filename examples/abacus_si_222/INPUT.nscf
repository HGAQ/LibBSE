INPUT_PARAMETERS

# Optional 3x3x3 NSCF input for a later double-grid convergence study. The
# supplied run.sh uses the coarse 2x2x2 grid, so this file is not run there.
suffix                  nscf
read_file_dir           OUT.scf
pseudo_dir              ./
orbital_dir             ./
calculation             nscf
basis_type              lcao
gamma_only              0
nbands                  44
symmetry                -1
nspin                   1
dft_functional          pbe
rpa                     0
out_mat_xc              1
out_wfc_lcao            1
out_chg                -1
init_chg                file
ecutwfc                 120
scf_thr                 1e-6
scf_nmax                50
smearing_method         gaussian
smearing_sigma          0.002
