# Export KS/RI/Coulomb/momentum data. This does not run native aims GW.
xc pbe
relativistic atomic_zora scalar
override_illconditioning true
k_grid 3 3 3
qpe_calc gw_expt
frequency_points 16
anacon_type 0
periodic_gw_optimize_kgrid_symmetry inverse
compute_momentummatrix 0 100 0
output librpa bse

output band 0.00000000 0.00000000 0.00000000 0.00000000 0.00000000 0.75000000 4
output band 0.00000000 0.25000000 0.00000000 0.00000000 0.25000000 0.75000000 4
