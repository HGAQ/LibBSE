# Minimal silicon workflow input for the FHI-aims -> LibRPA -> LibBSE path.
# The qpe_calc line is currently required by the patched `output librpa bse`
# exporter. LibBSE deliberately ignores FHI-aims QP files: its QP energies are
# read from the standalone LibRPA energy_qp file.
xc                                pbe
relativistic                      atomic_zora scalar
override_illconditioning          true
k_grid                            3 3 3
qpe_calc                           gw_expt
frequency_points                  16
anacon_type                        0
# Inversion-only reduction preserves q/-q conjugation without requiring
# point-group rotations of degenerate KS subspaces in standalone LibRPA.
periodic_gw_optimize_kgrid_symmetry inverse

# Export all regular-grid momentum elements in the 0--100 eV window. In this
# patched periodic interface, final argument 0 means all k points.
compute_momentummatrix             0 100 0

# Export the structure, KS bands/wavefunctions, RI vertices, Coulomb matrices,
# and the packed BSE momentum form. The adapter accepts both this packed form
# and the standard mommat.h5 written by compute_momentummatrix.
output librpa bse

################################################################################
# Compact Si species defaults used by the validated 3x3x3 data set.
################################################################################
species        Si
  nucleus             14
  mass                28.0855
  l_hartree           6
  cut_pot             4.0  2.0  1.0
  basis_dep_cutoff    1e-4
  radial_base         42 7.0
  radial_multiplier   2
  angular_grids       specified
    division   0.4121   50
    division   0.7665  110
    division   1.0603  194
    division   1.2846  302
    division   1.4125  434
    outer_grid         434
  valence      3  s   2.
  valence      3  p   2.
  ion_occ      3  s   1.
  ion_occ      3  p   1.
  hydro        3  d   4.2
  hydro        2  p   1.4
  hydro        4  f   6.2
  ionic        3  s   auto
  for_aux      hydro 5 g 9.4
