INPUT_PARAMETERS

# Ground-state and LibRPA-interface export.
suffix                  scf
pseudo_dir              ./
orbital_dir             ./
calculation             scf
basis_type              lcao
gamma_only              0
nbands                  44
symmetry                -1
nspin                   1
dft_functional          pbe

# These four lines create the complete OUT.librpa data set. In particular,
# rpa_out_vel=1 is mandatory for LibBSE's velocity-gauge optical analysis.
rpa                     1
rpa_out_vel             1
rpa_outdir              ./OUT.librpa/
out_unshrinked_v        1

out_chg                 1
out_mat_xc              1
ecutwfc                 120
scf_thr                 1e-6
scf_nmax                100
smearing_method         gaussian
smearing_sigma          0.002
mixing_type             pulay
mixing_beta             0.4
mixing_gg0              0

# Local RI settings used by the verified silicon calculation.
exx_singularity_correction massidda
exx_real_number         1
exx_ccp_rmesh_times     2
rpa_ccp_rmesh_times     5
exx_pca_threshold       10
shrink_abfs_pca_thr     1e-6
shrink_lu_inv_thr       1e-6
