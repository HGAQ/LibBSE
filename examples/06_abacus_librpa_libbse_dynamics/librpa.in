task = g0w0
input_dir = OUT.librpa_chi0
# ABACUS writes the diagonal KS-basis Vxc values to OUT.<suffix>, not
# rpa_outdir.  Resolve this path relative to input_dir.
fn_vxc_scf = ../OUT.scf/vxc_out.dat
output_dir = librpa.d
# Si pseudopotential: all four occupied + four empty states.
# Zero-based, half-open QP interval; keep consistent with nocc/nvirt.
i_state_low = 0
i_state_high = 8
nfreq = 16
tfgrids_type = minimax
parallel_routing = libri

option_dielect_func = 3
replace_w_head = t
use_scalapack_gw_wc = t
vq_threshold = 0
sqrt_coulomb_threshold = 0
use_shrink_abfs = f
use_shrink_chi = f

# LibBSE uses QP energies and bare chi0 at exactly zero frequency.
output_energy_qp = t
output_wc_rf = f
ifreq_output_wc_end = 1

# chi0 export uses one matching producer basis without a further shrink transform.
use_symmetry_rpa = f
use_symmetry_gw = f
use_symmetry_exx = f
output_chi0_rf = f
output_chi0_static = t
